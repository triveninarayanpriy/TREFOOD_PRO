{
  "name": "trefood-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply trefood-db --local",
    "db:migrate:local": "wrangler d1 migrations apply trefood-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trefood-db --remote",
    "db:seed": "wrangler d1 execute trefood-db --local --file=./scripts/seed.sql",
    "db:seed:local": "wrangler d1 execute trefood-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute trefood-db --remote --file=./scripts/seed.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@tanstack/react-query": "^5.90.16",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "i18next": "^24.2.2",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.5.0",
    "zod": "^3.25.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "^1.2.6",
    "@cloudflare/vitest-pool-workers": "^0.8.20",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.2",
    "wrangler": "^4.159.0"
  }
}
