{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trefood-prototype",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trefood-db",
      "database_id": "32e25eab-fd65-4479-b80d-3c358ba36eb0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "de2256e9754b48bd8d2e4da2e2ee6f4a"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "8289eb85cde74a3bbd7f52b255e496be"
    }
  ],
  // Optional R2 bucket for vendor menu photography (enable R2 in Cloudflare Dashboard before uncommenting):
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA_BUCKET",
  //     "bucket_name": "trefood-media"
  //   }
  // ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DEMO_MODE": "true",
    "ALLOWED_EMAIL_DOMAINS": "nitp.ac.in",
    "TIMEZONE": "Asia/Kolkata",
    "TURNSTILE_ENABLED": "false"
  }
}
